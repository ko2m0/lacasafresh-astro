---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import BridgeSection from '@/components/editorial/BridgeSection.astro';
import NetworkSection from '@/components/network/NetworkSection.astro';
import StorySection from '@/components/editorial/StorySection.astro';
import StatsSection from '@/components/stats/StatsSection.astro';
import ContactCTA from '@/components/contact/ContactCTA.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { content } from '@/content/en';
import { locations } from '@/data/locations';
import { statistics } from '@/data/statistics';
---

<MainLayout
  title="About · La Casa Fresh"
  description="Mexican roots. American reach. La Casa Fresh is the commercial bridge between Mexican growers and U.S. buyers — built on relationships, not transactions."
  lang="en"
>
  <SiteHeader lang="en" />

  <main>
    <section class="pt-40 pb-24 px-6 md:px-8 bg-cream">
      <Container size="xl">
        <Reveal>
          <SectionLabel text="Our Story" color="green" />
        </Reveal>
        <Reveal delay={1}>
          <h1 class="display text-display-xl uppercase mb-8 max-w-5xl">
            Not just a supplier.<br />
            <span class="text-green-700">The bridge.</span>
          </h1>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-xl text-gray max-w-3xl leading-relaxed">
            La Casa Fresh is the commercial link between Mexico's agricultural heartland and the U.S. markets that depend on it. Two decades of relationships. A network that moves. Product that arrives right.
          </p>
        </Reveal>
      </Container>
    </section>

    <BridgeSection content={content.bridge} />
    <StatsSection stats={statistics.en} />
    <NetworkSection lang="en" locations={locations} content={content.network} />
    <StorySection content={content.story} />
    <ContactCTA content={content.cta} />
  </main>

  <SiteFooter lang="en" />
</MainLayout>