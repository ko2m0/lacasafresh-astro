---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Hero from '@/components/hero/Hero.astro';
import ProductMarquee from '@/components/marquee/ProductMarquee.astro';
import BridgeSection from '@/components/editorial/BridgeSection.astro';
import ProductGrid from '@/components/products/ProductGrid.astro';
import StatsSection from '@/components/stats/StatsSection.astro';
import CommercialPaths from '@/components/commercial/CommercialPaths.astro';
import NetworkSection from '@/components/network/NetworkSection.astro';
import StorySection from '@/components/editorial/StorySection.astro';
import ContactCTA from '@/components/contact/ContactCTA.astro';

import { content } from '@/content/en';
import { products } from '@/data/products';
import { locations } from '@/data/locations';
import { statistics } from '@/data/statistics';
import { commercialPaths } from '@/data/commercial';
import { WHATSAPP } from '@/data/whatsapp'; 
const whatsappUrl = WHATSAPP.getUrl();
---

<MainLayout
  title="Fresh Produce From The Source"
  description="La Casa Fresh connects Mexican growers and packing operations with commercial buyers across the United States. Avocados, limes, mangoes, guavas and more."
  lang="en"
>
  <SiteHeader lang="en" />

  <main>
    <Hero content={content.hero} />
    <ProductMarquee lang="en" />
    <BridgeSection content={content.bridge} />
    <ProductGrid products={products} lang="en" content={content.products} />
    <StatsSection stats={statistics.en} />
    <CommercialPaths lang="en" paths={commercialPaths.en} content={content.paths} />
    <NetworkSection lang="en" locations={locations} content={content.network} />
    <StorySection content={content.story} />
    <ContactCTA content={content.cta} />
  </main>

  <SiteFooter lang="en" />
</MainLayout>

 <!-- Floating Action Buttons -->
    <div class="fixed bottom-6 right-6 fab-container z-40">
        <a
        data-location="floating_wa"
        href={whatsappUrl} target="_blank" rel="noopener" class="block w-20 h-20 bg-green-500 rounded-full items-center justify-center shadow-lg hover:bg-green-600 transition-all mb-4 flex">
            <svg class="w-11 h-11 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            
        </a>
        <button id="scroll-to-top" class="w-14 h-14 bg-yellow rounded-full flex items-center justify-center shadow-lg hover:bg-white transition-all opacity-0 pointer-events-none ml-4">
            <svg class="w-6 h-6 text-c8-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
        </button>
    </div>

    <script is:inline>
        // Scroll to Top Button
            var scrollToTopBtn = document.getElementById('scroll-to-top');
            if (scrollToTopBtn) {
                window.addEventListener('scroll', function() {
                    if (window.pageYOffset > 300) {
                        scrollToTopBtn.classList.add('visible');
                    } else {
                        scrollToTopBtn.classList.remove('visible');
                    }
                });

                scrollToTopBtn.addEventListener('click', function() {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
    </script>

    