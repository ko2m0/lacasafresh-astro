---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Button from '@/components/ui/Button.astro';
import ProductGrid from '@/components/products/ProductGrid.astro';
import { content } from '@/content/en';
import { products } from '@/data/products';
import { commercialPaths } from '@/data/commercial';
---

<MainLayout
  title="For Importers & Distributors · La Casa Fresh"
  description="Reliable Mexican produce supply for U.S. importers, distributors, retail and foodservice buyers. Direct sourcing, FTL/LTL logistics, year-round availability."
  lang="en"
>
  <SiteHeader lang="en" />

  <main>
    <section class="pt-40 pb-24 px-6 md:px-8 bg-green-700 text-white">
      <Container size="xl">
        <Reveal>
          <SectionLabel text={commercialPaths.en.buyer.tag} color="yellow" />
        </Reveal>
        <Reveal delay={1}>
          <h1 class="display text-display-xl uppercase mb-8">
            {commercialPaths.en.buyer.title}
          </h1>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-xl text-white/85 max-w-2xl leading-relaxed mb-12">
            {commercialPaths.en.buyer.description}
          </p>
        </Reveal>
        <Reveal delay={3}>
          <Button href="/en/contact/?type=buyer" variant="primary" dataCta="buyer-inquiry" size="lg">
            Start Buying →
          </Button>
        </Reveal>
      </Container>
    </section>

    <section class="py-24 px-6 md:px-8 bg-cream">
      <Container size="xl">
        <Reveal>
          <SectionLabel text="What We Offer" color="green" />
        </Reveal>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mt-12">
          {commercialPaths.en.buyer.list.map((item, i) => (
            <Reveal delay={(i + 1) as 1 | 2 | 3 | 4}>
              <div class="p-8 bg-white rounded-xl border border-gray-light">
                <div class="display text-5xl text-yellow mb-4">0{i + 1}</div>
                <p class="text-base leading-relaxed">{item}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </Container>
    </section>

    <ProductGrid products={products.filter(p => p.featured)} lang="en" content={content.products} />
  </main>

  <SiteFooter lang="en" />
</MainLayout>