---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import ProductGrid from '@/components/products/ProductGrid.astro';
import ContactCTA from '@/components/contact/ContactCTA.astro';
import { content } from '@/content/en';
import { products } from '@/data/products';
---

<MainLayout
  title="Products · Mexican Fresh Produce"
  description="Explore the La Casa Fresh product portfolio — avocados, limes, mangoes, guavas, papaya, broccoli and more, sourced directly from Mexico."
  lang="en"
>
  <SiteHeader lang="en" />

  <main>
    <section class="pt-40 pb-20 px-6 md:px-8 bg-black text-white">
      <Container size="xl">
        <Reveal>
          <SectionLabel text="The Portfolio" color="yellow" />
        </Reveal>
        <Reveal delay={1}>
          <h1 class="display text-display-xl uppercase mb-8">
            What we <span class="text-yellow">move.</span>
          </h1>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-lg text-white/70 max-w-2xl leading-relaxed">
            A curated portfolio of Mexican fresh produce, available year-round or in season. Sourced from our network of growers and packing partners.
          </p>
        </Reveal>
      </Container>
    </section>

    <ProductGrid products={products} lang="en" content={content.products} />
    <ContactCTA content={content.cta} />
  </main>

  <SiteFooter lang="en" />
</MainLayout>