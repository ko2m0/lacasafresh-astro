---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import BridgeSection from '@/components/editorial/BridgeSection.astro';
import NetworkSection from '@/components/network/NetworkSection.astro';
import StorySection from '@/components/editorial/StorySection.astro';
import StatsSection from '@/components/stats/StatsSection.astro';
import ContactCTA from '@/components/contact/ContactCTA.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { content } from '@/content/es';
import { locations } from '@/data/locations';
import { statistics } from '@/data/statistics';
---

<MainLayout
  title="Nosotros · La Casa Fresh"
  description="Raíces mexicanas. Alcance americano. La Casa Fresh es el puente comercial entre productores mexicanos y compradores en EE.UU. — construido sobre relaciones, no transacciones."
  lang="es"
>
  <SiteHeader lang="es" />

  <main>
    <section class="pt-40 pb-24 px-6 md:px-8 bg-cream">
      <Container size="xl">
        <Reveal>
          <SectionLabel text="Nuestra Historia" color="green" />
        </Reveal>
        <Reveal delay={1}>
          <h1 class="display text-display-xl uppercase mb-8 max-w-5xl">
            No solo un proveedor.<br />
            <span class="text-green-700">El puente.</span>
          </h1>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-xl text-gray max-w-3xl leading-relaxed">
            La Casa Fresh es el enlace comercial entre el corazón agrícola de México y los mercados de EE.UU. que dependen de él. Dos décadas de relaciones. Una red que se mueve. Producto que llega bien.
          </p>
        </Reveal>
      </Container>
    </section>

    <BridgeSection content={content.bridge} />
    <StatsSection stats={statistics.es} />
    <NetworkSection lang="es" locations={locations} content={content.network} />
    <StorySection content={content.story} />
    <ContactCTA content={content.cta} />
  </main>

  <SiteFooter lang="es" />
</MainLayout>