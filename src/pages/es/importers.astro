---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import Button from '@/components/ui/Button.astro';
import ProductGrid from '@/components/products/ProductGrid.astro';
import { content } from '@/content/es';
import { products } from '@/data/products';
import { commercialPaths } from '@/data/commercial';
---

<MainLayout
  title="Para Importadores y Distribuidores · La Casa Fresh"
  description="Abasto confiable de producto fresco mexicano para importadores, distribuidores, retail y foodservice en EE.UU. Abasto directo, logística FTL/LTL, disponibilidad todo el año."
  lang="es"
>
  <SiteHeader lang="es" />

  <main>
    <section class="pt-40 pb-24 px-6 md:px-8 bg-green-700 text-white">
      <Container size="xl">
        <Reveal>
          <SectionLabel text={commercialPaths.es.buyer.tag} color="yellow" />
        </Reveal>
        <Reveal delay={1}>
          <h1 class="display text-display-xl uppercase mb-8">
            {commercialPaths.es.buyer.title}
          </h1>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-xl text-white/85 max-w-2xl leading-relaxed mb-12">
            {commercialPaths.es.buyer.description}
          </p>
        </Reveal>
        <Reveal delay={3}>
          <Button href="/es/contact/?type=buyer" variant="primary" dataCta="buyer-inquiry" size="lg">
            Quiero comprar →
          </Button>
        </Reveal>
      </Container>
    </section>

    <section class="py-24 px-6 md:px-8 bg-cream">
      <Container size="xl">
        <Reveal>
          <SectionLabel text="Lo Que Ofrecemos" color="green" />
        </Reveal>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mt-12">
          {commercialPaths.es.buyer.list.map((item, i) => (
            <Reveal delay={(i + 1) as 1 | 2 | 3 | 4}>
              <div class="p-8 bg-white rounded-xl border border-gray-light">
                <div class="display text-5xl text-yellow mb-4">0{i + 1}</div>
                <p class="text-base leading-relaxed">{item}</p>
              </div>
            </Reveal>
          ))}
        </div>
      </Container>
    </section>

    <ProductGrid products={products.filter(p => p.featured)} lang="es" content={content.products} />
  </main>

  <SiteFooter lang="es" />
</MainLayout>