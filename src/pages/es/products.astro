---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import ProductGrid from '@/components/products/ProductGrid.astro';
import ContactCTA from '@/components/contact/ContactCTA.astro';
import { content } from '@/content/es';
import { products } from '@/data/products';
---

<MainLayout
  title="Productos · Producto Fresco Mexicano"
  description="Conoce el portafolio de La Casa Fresh — aguacates, limones, mangos, guayabas, papaya, brócoli y más, abastecidos directamente desde México."
  lang="es"
>
  <SiteHeader lang="es" />

  <main>
    <section class="pt-40 pb-20 px-6 md:px-8 bg-black text-white">
      <Container size="xl">
        <Reveal>
          <SectionLabel text="El Portafolio" color="yellow" />
        </Reveal>
        <Reveal delay={1}>
          <h1 class="display text-display-xl uppercase mb-8">
            Lo que <span class="text-yellow">movemos.</span>
          </h1>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-lg text-white/70 max-w-2xl leading-relaxed">
            Un portafolio curado de producto fresco mexicano, disponible todo el año o en temporada. Abastecido desde nuestra red de productores y empacadores.
          </p>
        </Reveal>
      </Container>
    </section>

    <ProductGrid products={products} lang="es" content={content.products} />
    <ContactCTA content={content.cta} />
  </main>

  <SiteFooter lang="es" />
</MainLayout>