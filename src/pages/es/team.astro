---
import MainLayout from '@/layouts/MainLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import TeamGrid from '@/components/team/TeamGrid.astro';
import LocationMap from '@/components/location/LocationMap.astro';
import { content } from '@/content/es';
import { teamMembers } from '@/data/team';
import { contact } from '@/data/contact';
---

<MainLayout
  title="Conoce al Equipo · La Casa Fresh"
  description="Conoce a las personas detrás de La Casa Fresh — el equipo de ventas, relaciones con productores y liderazgo que conecta producto mexicano con mercados norteamericanos."
  lang="es"
>
  <SiteHeader lang="es" />

  <main>
    <section class="team-hero">
      <div class="team-hero__inner">
        <div class="team-hero__label">La Gente</div>
        <h1 class="team-hero__title">
          No una <span class="team-hero__accent">empresa.</span><br />
          Una familia.
        </h1>
        <p class="team-hero__description">
          La Casa Fresh funciona con relaciones. Conoce a las personas que contestan el teléfono, cierran los tratos y mantienen el producto moviéndose de Michoacán a Manhattan.
        </p>
      </div>
    </section>

    <TeamGrid members={teamMembers} lang="es" content={content.team} />

    <LocationMap
      title="Pharr, Texas"
      subtitle="Sede y Centro de Distribución"
      address="Pharr, TX 78577, Estados Unidos"
      mapQuery="Pharr, TX 78577"
      phone={contact.phoneDisplay}
      email={contact.email}
      hours="Lun–Vie · 8:00 AM – 6:00 PM CST"
      accent="yellow"
    />
  </main>

  <SiteFooter lang="es" />
</MainLayout>

<style>
  .team-hero {
    padding: 10rem 1.5rem 5rem;
    background: var(--color-black);
    color: var(--color-white);
  }
  .team-hero__inner {
    max-width: 1600px;
    margin: 0 auto;
  }
  .team-hero__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-yellow);
    font-weight: 700;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .team-hero__label::before {
    content: '';
    width: 30px;
    height: 2px;
    background: var(--color-yellow);
  }
  .team-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: 2rem;
    max-width: 900px;
  }
  .team-hero__accent {
    color: var(--color-yellow);
  }
  .team-hero__description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    max-width: 600px;
  }
</style>