---
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';

type Props = {
  content: {
    label: string;
    title: string[];
    paragraphs: string[];
    stat: { value: string; label: string };
  };
};
const { content: c } = Astro.props;
---

<section class="py-24 md:py-32 px-6 md:px-8 bg-cream">
  <Container size="xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
      <div>
        <Reveal>
          <SectionLabel text={c.label} color="green" />
        </Reveal>
        <Reveal delay={1}>
          <h2 class="text-display-lg uppercase mb-8 text-black">
            {c.title[0]}<br />
            <em class="not-italic text-green-700 inline-block">{c.title[1]}</em>
          </h2>
        </Reveal>
        {c.paragraphs.map((p, i) => (
          <Reveal delay={(i + 2) as 2 | 3}>
            <p class="text-lg leading-relaxed text-gray mb-8 max-w-xl">{p}</p>
          </Reveal>
        ))}
      </div>

      <Reveal delay={2}>
        <div class="relative aspect-[4/5] bg-green-700 rounded-lg overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,rgba(254,221,0,0.3)_0%,transparent_40%),radial-gradient(circle_at_70%_70%,rgba(0,0,0,0.4)_0%,transparent_50%),linear-gradient(135deg,#3d5a1f_0%,#2d4a18_50%,#1a2e0a_100%)]"></div>
          <div class="absolute top-8 right-8 w-32 h-32 border-2 border-yellow/30 rounded-full z-[1]">
            <div class="absolute inset-5 border border-yellow/20 rounded-full"></div>
          </div>
          <div class="absolute inset-0 flex flex-col justify-end p-10 text-white z-10">
            <div class="display text-8xl leading-[0.8] text-yellow mb-2">
              {c.stat.value}
            </div>
            <div class="text-xs uppercase tracking-[0.15em] opacity-80">
              {c.stat.label}
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </Container>
</section>