---
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';

type Props = {
  content: {
    label: string;
    quote: string[];
    attribution: string;
  };
};
const { content: c } = Astro.props;
---

<section class="py-40 px-6 md:px-8 bg-black text-white relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 display text-[25vw] uppercase text-white/[0.02] whitespace-nowrap pointer-events-none select-none">
    FRESH
  </div>
  <Container size="lg">
    <div class="text-center">
      <Reveal>
        <SectionLabel text={c.label} color="yellow" class="justify-center" />
      </Reveal>
      <Reveal delay={1}>
        <blockquote class="display text-display-lg uppercase mb-12">
          {c.quote[0]}<br />
          <em class="not-italic text-yellow">{c.quote[1]}</em>
        </blockquote>
      </Reveal>
      <Reveal delay={2}>
        <p class="text-sm uppercase tracking-[0.15em] opacity-60">{c.attribution}</p>
      </Reveal>
    </div>
  </Container>
</section>