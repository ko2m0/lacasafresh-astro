---
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import ProductCard from './ProductCard.astro';
import type { Product } from '@/data/products';

type Props = {
  products: Product[];
  lang: 'en' | 'es';
  content: {
    label: string;
    title: string[];
    count: string;
    countLabel: string;
  };
};
const { products, lang, content: c } = Astro.props;
---

<section class="py-24 md:py-32 px-6 md:px-8 bg-black text-white relative overflow-hidden">
  <Container size="xl">
    <div class="flex flex-wrap justify-between items-end gap-8 mb-20">
      <div>
        <Reveal>
          <SectionLabel text={c.label} color="yellow" />
        </Reveal>
        <Reveal delay={1}>
          <h2 class="text-display-lg uppercase max-w-3xl">
            {c.title[0]}<br />{c.title[1]}
          </h2>
        </Reveal>
      </div>
      <Reveal delay={2}>
        <div class="display text-8xl text-yellow leading-none">
          {c.count}
          <small class="block font-body text-xs text-white/50 uppercase tracking-[0.15em] mt-2 font-normal">
            {c.countLabel}
          </small>
        </div>
      </Reveal>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map((product, i) => (
        <ProductCard product={product} lang={lang} delay={(i % 4) as 0 | 1 | 2 | 3} />
      ))}
    </div>
  </Container>
</section>