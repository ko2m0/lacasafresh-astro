---
import { Image } from 'astro:assets';
import type { Product } from '@/data/products';

type Props = {
  product: Product;
};
const { product } = Astro.props;

// CSS shape definitions (fallback)
const shapeStyles: Record<Product['visual'], string> = {
  avocado: 'width: 65%; aspect-ratio: 0.85; border-radius: 48% 52% 45% 55% / 55% 48% 52% 45%; background: radial-gradient(ellipse at 35% 35%, #4a6b2a, #1a2e0a 60%, #0a1505);',
  lime: 'width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #9ccc65, #33691e 60%, #1a3a0a);',
  mango: 'width: 60%; aspect-ratio: 1.2; border-radius: 55% 45% 50% 50% / 50% 50% 50% 50%; background: radial-gradient(ellipse at 40% 30%, #ffb74d, #e65100 60%, #4a1500);',
  keylime: 'width: 45%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 40%, #dce775, #827717 60%, #3a3500);',
  guava: 'width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #f48fb1, #880e4f 60%, #3a0020);',
  nance: 'width: 40%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 40% 40%, #fff176, #f57f17 60%, #5d3a00);',
  papaya: 'width: 55%; aspect-ratio: 1.3; border-radius: 50% 50% 48% 52% / 55% 50% 50% 45%; background: radial-gradient(ellipse at 40% 35%, #ff8a65, #bf360c 60%, #3e0f00);',
  broccoli: 'width: 60%; aspect-ratio: 1; border-radius: 45% 55% 50% 50% / 50% 45% 55% 50%; background: radial-gradient(circle at 35% 35%, #81c784, #1b5e20 60%, #0a2a0a);',
};
---

{product.image ? (
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-[55%] w-[70%] transition-transform duration-500 group-hover:scale-105 group-hover:-translate-y-[58%] z-10">
    <Image
      src={product.image}
      alt={product.name.en}
      width={800}
      height={1067}
      format="webp"
      loading="lazy"
      class="w-full h-auto object-contain drop-shadow-2xl"
    />
  </div>
) : (
  <!-- CSS SHAPE FALLBACK MODE -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-[55%] opacity-90 transition-transform duration-500 group-hover:scale-105 group-hover:-translate-y-[58%]"
    style={shapeStyles[product.visual]}
    aria-hidden="true"
  ></div>
)}