---
type Props = {
  href: string;
  variant?: 'primary' | 'secondary' | 'cta';
  dataCta?: string;
  class?: string;
  size?: 'md' | 'lg';
};
const {
  href,
  variant = 'primary',
  dataCta,
  class: className = '',
  size = 'md',
} = Astro.props;

const variants = {
  primary:
    'bg-yellow text-black hover:scale-105',
  secondary:
    'bg-transparent text-white border-2 border-white/30 hover:border-white hover:bg-white/5',
  cta:
    'bg-yellow text-black font-bold hover:scale-105',
};

const sizes = {
  md: 'px-8 py-4 text-sm',
  lg: 'px-10 py-5 text-base',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 rounded-full font-bold uppercase tracking-wide transition-transform duration-200',
    variants[variant],
    sizes[size],
    className,
  ]}
  data-cta={dataCta}
>
  <slot />
</a>