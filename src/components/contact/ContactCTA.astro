---
import Container from '@/components/ui/Container.astro';
import Reveal from '@/components/ui/Reveal.astro';
import { contact } from '@/data/contact';

type Props = {
  content: {
    title: string[];
    description: string;
    primary: string;
    secondary: string;
  };
};
const { content: c } = Astro.props;
---

<section id="contact" class="py-24 md:py-32 px-6 md:px-8 bg-green-700 text-white relative overflow-hidden">
  <Container size="lg">
    <div class="text-center relative z-10">
      <Reveal>
        <h2 class="display text-display-xl uppercase mb-6 leading-[0.95]">
          {c.title[0]} <em class="not-italic text-yellow">{c.title[1]}</em>
        </h2>
      </Reveal>
      <Reveal delay={1}>
        <p class="text-lg leading-relaxed opacity-85 mb-12 max-w-2xl mx-auto">
          {c.description}
        </p>
      </Reveal>
      <Reveal delay={2}>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href={`mailto:${contact.email}`}
            class="inline-flex items-center gap-2 bg-yellow text-black px-10 py-4 rounded-full font-bold text-base uppercase tracking-wider no-underline hover:scale-105 transition-transform"
            data-cta="email"
          >
            {c.primary}
          </a>
          <a
            href={`tel:${contact.phone}`}
            class="inline-flex items-center gap-2 bg-transparent text-white px-10 py-4 rounded-full font-bold text-base uppercase tracking-wider no-underline border-2 border-white/30 hover:border-white hover:bg-white/5 transition-all"
            data-cta="phone"
          >
            {c.secondary}
          </a>
        </div>
      </Reveal>
    </div>
  </Container>
</section>