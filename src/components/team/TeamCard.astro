---
import type { TeamMember } from '@/data/team';

type Props = {
  member: TeamMember;
  lang: 'en' | 'es';
  featured?: boolean;
};

const { member, lang, featured = false } = Astro.props;

const whatsappUrl = member.whatsapp
  ? `https://wa.me/${member.whatsapp.replace(/\+/g, '').replace(/\s/g, '')}`
  : null;
---

<article class:list={['team-card', featured && 'team-card--featured']}>
  <div class="team-card__photo">
    {member.photo ? (
      <img src={member.photo} alt={member.name} loading="lazy" />
    ) : (
      <div class="team-card__photo-placeholder">
        <span>{member.name.split(' ').map(n => n[0]).join('').slice(0, 2)}</span>
      </div>
    )}
    {featured && <div class="team-card__badge">CEO & Founder</div>}
  </div>

  <div class="team-card__content">
    <h3 class="team-card__name">{member.name}</h3>
    <p class="team-card__role">{member.role[lang]}</p>
    <p class="team-card__bio">{member.bio[lang]}</p>

    <div class="team-card__contacts">
      {member.email && (
        <a
          href={`mailto:${member.email}`}
          class="team-card__contact"
          data-cta="email"
          data-team-member={member.slug}
          aria-label={`Email ${member.name}`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>Email</span>
        </a>
      )}
      {member.phone && (
        <a
          href={`tel:${member.phone.replace(/\s/g, '')}`}
          class="team-card__contact"
          data-cta="phone"
          data-team-member={member.slug}
          aria-label={`Call ${member.name}`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call</span>
        </a>
      )}
      {whatsappUrl && (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="team-card__contact team-card__contact--whatsapp"
          data-cta="whatsapp"
          data-team-member={member.slug}
          aria-label={`WhatsApp ${member.name}`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      )}
      {member.linkedin && (
        <a
          href={member.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="team-card__contact"
          data-cta="linkedin"
          data-team-member={member.slug}
          aria-label={`${member.name} on LinkedIn`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span>LinkedIn</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .team-card {
    background: var(--color-white);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid var(--color-gray-light);
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  .team-card--featured {
    background: var(--color-black);
    color: var(--color-white);
    grid-column: span 2;
    flex-direction: row;
    border: none;
  }

  .team-card__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-cream);
  }

  .team-card--featured .team-card__photo {
    aspect-ratio: auto;
    width: 45%;
    min-height: 400px;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .team-card:hover .team-card__photo img {
    transform: scale(1.03);
  }

  .team-card__photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-green) 0%, var(--color-green-dark) 100%);
    color: var(--color-yellow);
    font-family: var(--font-display);
    font-size: 4rem;
    letter-spacing: -0.02em;
  }

  .team-card--featured .team-card__photo-placeholder {
    font-size: 6rem;
  }

  .team-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--color-yellow);
    color: var(--color-black);
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .team-card__content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .team-card--featured .team-card__content {
    padding: 3rem;
    justify-content: center;
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .team-card--featured .team-card__name {
    font-size: 3rem;
  }

  .team-card__role {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-green);
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .team-card--featured .team-card__role {
    color: var(--color-yellow);
  }

  .team-card__bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-gray);
    margin-bottom: 1.5rem;
  }

  .team-card--featured .team-card__bio {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    max-width: 500px;
  }

  .team-card__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .team-card__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 100px;
    background: var(--color-cream);
    color: var(--color-black);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .team-card__contact:hover {
    background: var(--color-yellow);
    transform: translateY(-2px);
  }

  .team-card--featured .team-card__contact {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .team-card--featured .team-card__contact:hover {
    background: var(--color-yellow);
    color: var(--color-black);
    border-color: var(--color-yellow);
  }

  .team-card__contact--whatsapp:hover {
    background: #25D366;
    color: white;
  }

  @media (max-width: 768px) {
    .team-card--featured {
      grid-column: span 1;
      flex-direction: column;
    }
    .team-card--featured .team-card__photo {
      width: 100%;
      min-height: 280px;
    }
    .team-card--featured .team-card__name {
      font-size: 2rem;
    }
  }
</style>