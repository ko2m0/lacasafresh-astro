---

import { Image } from 'astro:assets';
import lcfmascot from '../../assets/images/hero/Mascot_0_75x.png'

type Props = {
  content: {
    tag: string;
    title: string[];
    titleAccents: boolean[];
    titleOutlines: boolean[];
    description: string;
  };
};
const { content: c } = Astro.props;
---

<section class="min-h-screen bg-black text-white relative overflow-hidden flex items-end pt-32 pb-16 px-6 md:px-8">
  <!-- Background gradients -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_30%,rgba(74,119,41,0.3)_0%,transparent_50%),radial-gradient(ellipse_at_20%_80%,rgba(254,221,0,0.15)_0%,transparent_50%),#0a0a0a]"></div>

  <!-- Grain texture -->
  <div class="absolute inset-0 opacity-30 pointer-events-none mix-blend-overlay"
       style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.4'/%3E%3C/svg%3E&quot;);"></div>





  <!-- Floating shapes -->
  <div class="absolute md:top-[15%] right-[5%] w-[45vw] h-[70vh] pointer-events-none z-[1] invisible md:visible" data-hero-parallax>
    <Image src={lcfmascot}
     alt="Let's talk Supply"
     decoding="async"
     />
  </div>

  <div class="relative z-10 w-full max-w-[1600px] mx-auto">
    
    
    <div class="reveal inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-yellow font-medium mb-8">
      <span class="inline-block w-10 h-px bg-yellow"></span>
      {c.tag}
    </div>

    <h1 class="text-display-xl uppercase mb-8">
      {c.title.map((line, i) => (
        <span class="block overflow-hidden">
          <span class:list={[
            'inline-block',
            c.titleAccents[i] && 'text-yellow',
            c.titleOutlines[i] && '[color:transparent] [-webkit-text-stroke:2px_white]',
          ]}>
            {line}
          </span>
        </span>
      ))}
    </h1>

    <div class="block md:hidden">
      <Image src={lcfmascot}
     alt="Let's talk Supply"
     decoding="async"
     loading="lazy"
     />
    </div>

    <div class="flex flex-wrap justify-between items-end gap-8 mt-12">
      <h3 class="reveal reveal-delay-2 max-w-md  leading-relaxed text-white/75 text-xl">
        {c.description}
      </h3>
      <div class="reveal reveal-delay-3 flex items-center gap-3 text-xs uppercase tracking-[0.15em] text-white/50">
        <div class="w-px h-16 bg-gradient-to-b from-yellow to-transparent animate-scroll-pulse origin-top"></div>
        <span>Scroll</span>
      </div>
    </div>
  </div>
</section>

<script>
  const parallax = document.querySelector<HTMLElement>('[data-hero-parallax]');
  if (parallax) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrolled = window.scrollY;
          if (scrolled < window.innerHeight) {
            parallax.style.transform = `translateY(${scrolled * 0.3}px)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>