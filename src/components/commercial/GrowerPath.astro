---
import Reveal from '@/components/ui/Reveal.astro';

type Props = {
  data: {
    tag: string;
    title: string;
    description: string;
    list: string[];
    cta: string;
    dataCta: string;
  };
  href: string;
  delay?: 0 | 1 | 2 | 3;
};
const { data, href, delay = 1 } = Astro.props;
---

<Reveal delay={delay}>
  <div class="bg-black text-white p-10 md:p-14 rounded-2xl relative overflow-hidden min-h-[500px] flex flex-col justify-between transition-transform duration-400 hover:-translate-y-1">
    <div class="display text-[10rem] leading-[0.8] absolute -top-4 right-4 opacity-10">02</div>
    <div>
      <div class="text-xs uppercase tracking-[0.2em] opacity-70 mb-4">{data.tag}</div>
      <h3 class="display text-display-md uppercase mb-6">{data.title}</h3>
      <p class="text-base leading-relaxed opacity-85 max-w-md mb-8">{data.description}</p>
      <ul class="space-y-0 mb-10">
        {data.list.map((item) => (
          <li class="py-2 border-t border-white/15 text-sm flex items-center gap-3">
            <span class="text-yellow font-bold">→</span>
            {item}
          </li>
        ))}
      </ul>
    </div>
    <a
      href={href}
      class="inline-flex items-center gap-3 bg-yellow text-black px-8 py-4 rounded-full font-bold text-sm uppercase tracking-wider no-underline transition-all duration-200 hover:gap-5 self-start"
      data-cta={data.dataCta}
    >
      {data.cta}
    </a>
  </div>
</Reveal>