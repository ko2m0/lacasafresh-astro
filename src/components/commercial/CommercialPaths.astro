---
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import BuyerPath from './BuyerPath.astro';
import GrowerPath from './GrowerPath.astro';

type Props = {
  lang: 'en' | 'es';
  paths: {
    buyer: any;
    grower: any;
  };
  content: {
    label: string;
    title: string[];
  };
};
const { lang, paths, content: c } = Astro.props;
---

<section class="py-24 md:py-32 px-6 md:px-8 bg-cream">
  <Container size="xl">
    <div class="text-center mb-20">
      <Reveal>
        <div class="flex justify-center">
          <SectionLabel text={c.label} color="green" />
        </div>
      </Reveal>
      <Reveal delay={1}>
        <h2 class="text-display-lg uppercase max-w-3xl mx-auto">
          {c.title[0]}<br />{c.title[1]}
        </h2>
      </Reveal>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <BuyerPath data={paths.buyer} href={`/${lang}/contact/?type=buyer`} />
      <GrowerPath data={paths.grower} href={`/${lang}/contact/?type=grower`} />
    </div>
  </Container>
</section>