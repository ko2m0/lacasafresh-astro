---
import Container from '@/components/ui/Container.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Reveal from '@/components/ui/Reveal.astro';
import NetworkMap from './NetworkMap.astro';
import type { Location } from '@/data/locations';

type Props = {
  lang: 'en' | 'es';
  locations: Location[];
  content: {
    label: string;
    title: string[];
    description: string;
  };
};
const { lang, locations, content: c } = Astro.props;
---

<section id="network" class="py-24 md:py-32 px-6 md:px-8 bg-white">
  <Container size="xl">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-24 items-center">
      <div>
        <Reveal>
          <SectionLabel text={c.label} color="green" />
        </Reveal>
        <Reveal delay={1}>
          <h2 class="text-display-lg uppercase mb-8">
            {c.title[0]}<br />
            <em class="not-italic text-green-700 inline-block">{c.title[1]}</em>
          </h2>
        </Reveal>
        <Reveal delay={2}>
          <p class="text-lg leading-relaxed text-gray mb-10">{c.description}</p>
        </Reveal>
        <Reveal delay={3}>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {locations.map((loc) => (
              <div class="p-6 border border-gray-light rounded-xl hover:border-green-700 hover:bg-green-700/[0.03] transition-all">
                <div class="text-2xl mb-2">{loc.flag}</div>
                <div class="display text-xl uppercase mb-1">{loc.name}</div>
                <div class="text-xs text-gray uppercase tracking-wider">{loc.role[lang]}</div>
              </div>
            ))}
          </div>
        </Reveal>
      </div>
      <Reveal delay={2}>
        <NetworkMap />
      </Reveal>
    </div>
  </Container>
</section>