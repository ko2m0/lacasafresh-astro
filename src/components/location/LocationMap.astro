---
type Props = {
  title: string;
  subtitle?: string;
  address: string;
  mapQuery: string; // Google Maps search query (address or coordinates)
  phone?: string;
  email?: string;
  hours?: string;
  accent?: 'yellow' | 'green';
};

const {
  title,
  subtitle,
  address,
  mapQuery,
  phone,
  email,
  hours,
  accent = 'yellow',
} = Astro.props;

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const accentColor = accent === 'yellow' ? 'var(--color-yellow)' : 'var(--color-green)';
---

<section class="location-map">
  <div class="location-map__inner">
    <div class="location-map__info">
      <div class="location-map__label" style={`color: ${accentColor};`}>
        <span class="location-map__label-line" style={`background: ${accentColor};`}></span>
        {subtitle || 'Our Facility'}
      </div>
      <h2 class="location-map__title">{title}</h2>
      <address class="location-map__address">{address}</address>

      <div class="location-map__details">
        {phone && (
          <a href={`tel:${phone}`} class="location-map__detail" data-cta="phone">
            <span class="location-map__detail-label">Phone</span>
            <span class="location-map__detail-value">{phone}</span>
          </a>
        )}
        {email && (
          <a href={`mailto:${email}`} class="location-map__detail" data-cta="email">
            <span class="location-map__detail-label">Email</span>
            <span class="location-map__detail-value">{email}</span>
          </a>
        )}
        {hours && (
          <div class="location-map__detail">
            <span class="location-map__detail-label">Hours</span>
            <span class="location-map__detail-value">{hours}</span>
          </div>
        )}
      </div>

      <a
        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="location-map__cta"
        style={`background: ${accentColor};`}
      >
        Open in Google Maps →
      </a>
    </div>

    <div class="location-map__embed">
      <iframe
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Map showing ${title}`}
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location-map {
    padding: clamp(5rem, 10vw, 8rem) 1.5rem;
    background: var(--color-black);
    color: var(--color-white);
  }

  .location-map__inner {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 4rem;
    align-items: stretch;
  }

  .location-map__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .location-map__label-line {
    width: 30px;
    height: 2px;
    display: inline-block;
  }

  .location-map__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }

  .location-map__address {
    font-style: normal;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2.5rem;
    max-width: 400px;
  }

  .location-map__details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .location-map__detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.2s ease;
  }

  a.location-map__detail:hover {
    padding-left: 0.5rem;
  }

  .location-map__detail-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 700;
  }

  .location-map__detail-value {
    font-size: 1.05rem;
    color: var(--color-white);
  }

  .location-map__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-yellow);
    color: var(--color-black);
    padding: 1rem 2rem;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: transform 0.2s ease;
    align-self: flex-start;
  }

  .location-map__cta:hover {
    transform: scale(1.03);
  }

  .location-map__embed {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    min-height: 500px;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .location-map__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.3) contrast(1.05);
  }

  @media (max-width: 1024px) {
    .location-map__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .location-map__embed {
      min-height: 400px;
    }
  }
</style>