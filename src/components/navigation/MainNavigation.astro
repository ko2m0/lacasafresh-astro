---
import type { NavItem } from '@/data/navigation';

type Props = {
  items: NavItem[];
  lang: 'en' | 'es';
};
const { items, lang } = Astro.props;
const otherLang = lang === 'en' ? 'es' : 'en';
---

<nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
  {items.filter(i => !i.cta).map((item) => (
    <a
      href={item.href}
      class="text-nav text-white no-underline hover:opacity-70 transition-opacity"
      data-cta={item.dataCta}
    >
      {item.label}
    </a>
  ))}
  <div class="flex items-center gap-2 border border-white/40 rounded-full px-3 py-1.5">
    <a
      href={`/${lang}/`}
      class:list={[
        'text-xs px-1.5 py-0.5 rounded-full no-underline',
        'text-white',
        lang === 'en' && 'bg-white text-black',
      ]}
      aria-current={lang === 'en' ? 'true' : undefined}
    >
      EN
    </a>
    <a
      href={`/${otherLang}/`}
      class:list={[
        'text-xs px-1.5 py-0.5 rounded-full no-underline',
        'text-white',
        lang === 'es' && 'bg-white text-black',
      ]}
      aria-current={lang === 'es' ? 'true' : undefined}
    >
      ES
    </a>
  </div>
  {items.filter(i => i.cta).map((item) => (
    <a
      href={item.href}
      class="bg-yellow text-black px-5 py-2.5 rounded-full font-bold text-nav no-underline hover:scale-105 transition-transform"
      data-cta={item.dataCta}
    >
      {item.label}
    </a>
  ))}
</nav>