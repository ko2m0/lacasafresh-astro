---
import type { NavItem } from '@/data/navigation';

type Props = {
  items: NavItem[];
  lang: 'en' | 'es';
};
const { items, lang } = Astro.props;
const otherLang = lang === 'en' ? 'es' : 'en';
---

<div
  id="mobile-menu"
  class="mobile-menu"
  data-mobile-menu
  aria-hidden="true"
>
  <nav class="mobile-menu__nav">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={[
          'mobile-menu__link',
          item.cta && 'mobile-menu__link--cta',
        ]}
        data-cta={item.dataCta}
      >
        {item.label}
      </a>
    ))}
    <div class="mobile-menu__lang">
      <a href={`/${lang}/`} class:list={['mobile-menu__lang-link', lang === 'en' && 'active']}>
        EN
      </a>
      <span class="mobile-menu__lang-sep">/</span>
      <a href={`/${otherLang}/`} class:list={['mobile-menu__lang-link', lang === 'es' && 'active']}>
        ES
      </a>
    </div>
  </nav>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    z-index: 999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 3rem;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1);
    opacity: 0;
    pointer-events: none;
  }

  .mobile-menu.open {
    transform: translateX(0);
    opacity: 1;
    pointer-events: all;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 400px;
  }

  .mobile-menu__link {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
    display: block;
  }

  .mobile-menu__link:hover {
    color: var(--color-yellow);
    padding-left: 1rem;
  }

  .mobile-menu__link--cta {
    color: var(--color-yellow);
    margin-top: 2rem;
  }

  .mobile-menu__lang {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu__lang-link {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    transition: all 0.2s ease;
  }

  .mobile-menu__lang-link:hover {
    color: white;
  }

  .mobile-menu__lang-link.active {
    background: white;
    color: black;
  }

  .mobile-menu__lang-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  @media (min-width: 769px) {
    .mobile-menu {
      display: none;
    }
  }
</style>