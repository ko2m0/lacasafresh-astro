---
import Container from '@/components/ui/Container.astro';
import StatItem from './StatItem.astro';

type Props = {
  stats: Array<{ value: string; label: string }>;
};
const { stats } = Astro.props;
---

<section class="py-24 px-6 md:px-8 bg-yellow border-y border-black">
  <Container size="xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      {stats.map((stat, i) => (
        <StatItem
          value={stat.value}
          label={stat.label}
          delay={i as 0 | 1 | 2 | 3}
          isLast={i === stats.length - 1}
        />
      ))}
    </div>
  </Container>
</section>