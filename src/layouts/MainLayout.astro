---
import '@/styles/global.css';

type Props = {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
};

const {
  title,
  description,
  lang = 'en',
  canonical,
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? 'https://lacasafresh.com';
const canonicalUrl = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();
const alternateEn = canonicalUrl.replace('/es/', '/en/');
const alternateEs = canonicalUrl.replace('/en/', '/es/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} · La Casa Fresh</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Casa Fresh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_MX'} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

   <!-- Preconnect to Google Fonts for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  
  <!-- Load BOTH Google Sans Flex and Londrina Solid -->
  <link
    href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,400;6..144,500;6..144,700&family=Londrina+Solid:wght@400&display=swap"
    rel="stylesheet"
  />

    <!-- GTM integration point (head) -->
    <!-- Slot for GTM head snippet via Astro.env -->
  </head>
  <body>
    <!-- GTM integration point (body) -->
    <slot />
  </body>
</html>