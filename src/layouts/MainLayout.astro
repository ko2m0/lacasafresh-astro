---
import '@/styles/global.css';

type Props = {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
};

const {
  title,
  description,
  lang = 'en',
  canonical,
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? 'https://lacasafresh.com';
const canonicalUrl = canonical ? new URL(canonical, siteUrl).toString() : new URL(Astro.url.pathname, siteUrl).toString();
const alternateEn = canonicalUrl.replace('/es/', '/en/');
const alternateEs = canonicalUrl.replace('/en/', '/es/');

import { WHATSAPP } from '@/data/whatsapp'; 
const whatsappUrl = WHATSAPP.getUrl();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} · La Casa Fresh</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Casa Fresh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_MX'} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

   <!-- Preconnect to Google Fonts for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  
  <!-- Load BOTH Google Sans Flex and Londrina Solid -->
  <link
    href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,400;6..144,500;6..144,700&family=Londrina+Solid:wght@400&display=swap"
    rel="stylesheet"
  />

    <!-- GTM integration point (head) -->
    <!-- Slot for GTM head snippet via Astro.env -->
  </head>
  <body>
    <!-- GTM integration point (body) -->
    <slot />
    <!-- Floating Action Buttons -->
    <div class="fixed bottom-6 right-6 fab-container z-40">
        <a
        data-location="floating_wa"
        href={whatsappUrl} target="_blank" rel="noopener" class="block w-20 h-20 bg-green-500 rounded-full items-center justify-center shadow-lg hover:bg-green-600 transition-all mb-4 flex">
            <svg class="w-11 h-11 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            
        </a>
        <button id="scroll-to-top" class="w-14 h-14 bg-yellow rounded-full flex items-center justify-center shadow-lg hover:bg-white transition-all opacity-0 pointer-events-none ml-4">
            <svg class="w-6 h-6 text-c8-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
        </button>
    </div>

    <script is:inline>
        // Scroll to Top Button
            var scrollToTopBtn = document.getElementById('scroll-to-top');
            if (scrollToTopBtn) {
                window.addEventListener('scroll', function() {
                    if (window.pageYOffset > 300) {
                        scrollToTopBtn.classList.add('visible');
                    } else {
                        scrollToTopBtn.classList.remove('visible');
                    }
                });

                scrollToTopBtn.addEventListener('click', function() {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
    </script>
  </body>
</html>